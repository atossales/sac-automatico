// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Account ───────────────────────────────────────────────────
// Representa uma conta Instagram Business conectada ao sistema.
// O accessToken é sempre armazenado criptografado (AES-256-GCM).
model Account {
  id             String    @id @default(cuid())
  instagramId    String    @unique
  name           String
  accessToken    String    // Criptografado com AES-256-GCM
  tokenExpiresAt DateTime
  pageId         String    @unique
  systemPrompt   String    @default("Você é um atendente educado e prestativo.")
  delayMin       Int       @default(3)   // Delay mínimo em segundos para simular digitação humana
  delayMax       Int       @default(12)  // Delay máximo em segundos para simular digitação humana
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  conversations  Conversation[]
  trackedLinks   TrackedLink[]

  @@index([pageId])
  @@index([isActive])
  @@index([tokenExpiresAt])
}

// ── Conversation ──────────────────────────────────────────────
// Agrupa as mensagens de um participante com uma conta.
// Um participante pode ter apenas uma conversa por conta.
model Conversation {
  id                   String    @id @default(cuid())
  accountId            String
  participantId        String    // ID do usuário no Instagram
  participantUsername  String?   // Username pode não estar disponível sempre
  lastMessageAt        DateTime
  createdAt            DateTime  @default(now())

  account              Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages             Message[]

  @@unique([accountId, participantId])
  @@index([accountId])
  @@index([lastMessageAt])
}

// ── Message ───────────────────────────────────────────────────
// Registro individual de cada mensagem trocada na conversa.
model Message {
  id             String      @id @default(cuid())
  conversationId String
  content        String      @db.Text
  role           MessageRole
  sentAt         DateTime
  messageId      String?     @unique // ID da mensagem no Instagram (pode ser null para mensagens geradas internamente)
  createdAt      DateTime    @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([sentAt])
}

enum MessageRole {
  USER
  ASSISTANT
}

// ── TrackedLink ───────────────────────────────────────────────
// Links rastreáveis enviados pela IA nos DMs.
// O shortCode é a parte final da URL curta (ex: /t/abc12345).
model TrackedLink {
  id          String      @id @default(cuid())
  accountId   String
  originalUrl String      @db.VarChar(2048)
  shortCode   String      @unique
  clicks      Int         @default(0)
  createdAt   DateTime    @default(now())

  account     Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  linkClicks  LinkClick[]

  @@unique([accountId, originalUrl])
  @@index([accountId])
  @@index([shortCode])
}

// ── LinkClick ─────────────────────────────────────────────────
// Registro individual de cada clique em um link rastreável.
// IP é armazenado para análise, mas deve ser tratado com cuidado (LGPD).
model LinkClick {
  id             String      @id @default(cuid())
  trackedLinkId  String
  clickedAt      DateTime    @default(now())
  userAgent      String?
  ip             String?

  trackedLink    TrackedLink @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)

  @@index([trackedLinkId])
  @@index([clickedAt])
}
