# ============================================================
# SAC Automático — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env com valores reais.
# ============================================================

# ── Node ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Banco de dados ──────────────────────────────────────────
# Usada pelo Prisma e pelo backend
DATABASE_URL=postgresql://sac_user:sac_password@localhost:5432/sac_automatico
POSTGRES_USER=sac_user
POSTGRES_PASSWORD=sac_password
POSTGRES_DB=sac_automatico

# ── Redis / BullMQ ──────────────────────────────────────────
REDIS_URL=redis://:sac_redis_password@localhost:6379
REDIS_PASSWORD=sac_redis_password

# ── Google Gemini ────────────────────────────────────────────
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Meta / Instagram ────────────────────────────────────────
# App ID e Secret do painel de desenvolvedor da Meta
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
# Token aleatório definido por você para verificação do webhook
META_WEBHOOK_VERIFY_TOKEN=your_random_verify_token
# Secret usado para validar X-Hub-Signature-256 nos webhooks
META_WEBHOOK_SECRET=your_meta_webhook_secret

# ── JWT ─────────────────────────────────────────────────────
# Gere com: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars

# ── Autenticação admin ───────────────────────────────────────
# Usuário do painel do gestor
ADMIN_USERNAME=admin
# Hash bcrypt da senha — gere com:
# node -e "require('bcryptjs').hash('suasenha', 10).then(console.log)"
ADMIN_PASSWORD=

# ── Criptografia de tokens ───────────────────────────────────
# AES-256 requer chave de 32 bytes (256 bits)
# Gere com: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# ── Link Tracker ─────────────────────────────────────────────
# URL base do backend (onde o tracker responde ao redirect)
TRACKER_BASE_URL=https://sac.seudominio.com/t

# ── Frontend ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── pgAdmin (opcional, perfil "tools") ───────────────────────
PGADMIN_EMAIL=admin@sac.local
PGADMIN_PASSWORD=admin
